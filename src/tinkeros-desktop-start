#!/bin/bash
export HOME=/home/tinkerspace
export USER=tinkerspace
export XAUTHORITY=/home/tinkerspace/.Xauthority

chown -R tinkerspace:tinkerspace /home/tinkerspace/ 2>/dev/null

# Start X server
/usr/bin/Xorg :0 -nolisten tcp -sharevts &
XPID=$!

# Wait for X to start
for i in $(seq 1 30); do
  sleep 1
  [ -S /tmp/.X11-unix/X0 ] && break
done

sleep 2

# Window manager (xfwm4 for Alt+Tab, minimize, maximize, close)
su tinkerspace -c "DISPLAY=:0 XAUTHORITY=/home/tinkerspace/.Xauthority xfwm4 --replace &" &

# Panel (taskbar, system tray, clock)
su tinkerspace -c "DISPLAY=:0 XAUTHORITY=/home/tinkerspace/.Xauthority xfce4-panel &" &

# Desktop (right-click menu, icons)
su tinkerspace -c "DISPLAY=:0 XAUTHORITY=/home/tinkerspace/.Xauthority xfdesktop &" &

# Chrome - NORMAL mode, web desktop as homepage
sleep 3
su tinkerspace -c "DISPLAY=:0 XAUTHORITY=/home/tinkerspace/.Xauthority google-chrome --no-sandbox --no-first-run --no-default-browser-check --disable-translate --disable-session-crashed-bubble --disable-infobars http://localhost:4040 &" &

# PulseAudio
su tinkerspace -c "pulseaudio --start &" &

wait $XPID
